POSTGRES_DB=bandatabase # Name of the PostgreSQL database.
POSTGRES_USER=vladimircosma # Username for the PostgreSQL database.
POSTGRES_PASSWORD= # Password for the PostgreSQL database.
ALLOWED_ORIGINS= # Comma-separated list of allowed origins for CORS (Cross-Origin Resource Sharing).
JJWT_SECRET_KEY= # Secret key for JWT token generation. 512-bit key in hexadecimal (non url-safe) format required for signing and verifying JWT tokens. It must be kept secret and not shared publicly.
JJWT_EXPIRATION= # Expiration time for JWT tokens in milliseconds.
PASSWORD_REGEX= # Regular expression for password validation.
PASSWORD_ENCODER_STRENGTH= # Strength of the password encoder.
PASSWORD_MIN_LENGTH= # Minimum length for passwords. Only for information purposes, as the actual validation is done using the regex.
PASSWORD_MAX_LENGTH= # Maximum length for passwords. Only for information purposes, as the actual validation is done using the regex.
PASSWORD_REQUIRE_UPPERCASE= # Whether passwords must contain an uppercase letter. Only for information purposes, as the actual validation is done using the regex.
PASSWORD_REQUIRE_LOWERCASE= # Whether passwords must contain a lowercase letter. Only for information purposes, as the actual validation is done using the regex.
PASSWORD_REQUIRE_DIGIT= # Whether passwords must contain a digit. Only for information purposes, as the actual validation is done using the regex.
PASSWORD_REQUIRE_SPECIAL_CHARACTER= # Whether passwords must contain a special character. Only for information purposes, as the actual validation is done using the regex.
SPRING_PROFILES_ACTIVE=dev # Active Spring profile.
DOCKERFILE_EXTENSION=.dev # Extension for the Dockerfile.